# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://whatsatendende:whatsatendende@localhost:5432/whatsatendende

# Redis is used for socket.io horizontal scaling and background job queues.
REDIS_URL=redis://localhost:6379

# Generate strong random secrets, e.g. `openssl rand -hex 32`. Never reuse
# across environments and never commit real values. These placeholders are
# deliberately too short to pass validation (env.ts requires 32+ chars) —
# the app refuses to start rather than silently run with a known secret.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME_TOO
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# mock -> MockWhatsAppProvider (safe for dev/CI, no real WhatsApp needed)
# baileys -> real WhatsApp Web protocol connection via Baileys
WHATSAPP_PROVIDER=mock
WHATSAPP_AUTH_DIR=./whatsapp-sessions

WEB_APP_URL=http://localhost:5173

UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=25

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Set to true only when the API is reached exclusively through a trusted
# reverse proxy that overwrites X-Forwarded-For itself (e.g. the nginx
# container in docker-compose.yml). Leave false for local/dev, otherwise a
# client can spoof its own IP for rate limiting and audit logs.
TRUST_PROXY=false
