# Used by docker-compose.yml when running the full stack in containers.
# Copy to .env and fill in real values. Never commit .env.
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-secret
WHATSAPP_PROVIDER=mock
WEB_APP_URL=http://localhost:8080
